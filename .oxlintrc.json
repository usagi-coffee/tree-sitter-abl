{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["tools/**"],
  "jsPlugins": [
    {
      "name": "tree-sitter-optimize",
      "specifier": "./tools/oxlint-plugin-tree-sitter-optimize.js"
    }
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^(?:\\$|kw)$",
        "varsIgnorePattern": "^\\$$"
      }
    ],
    "no-useless-escape": "off"
  },
  "overrides": [
    {
      "files": ["grammar.js", "grammar/**/*.js"],
      "rules": {
        "tree-sitter-optimize/shared-repeated-signature": "warn",
        "tree-sitter-optimize/left-recursive-list": "warn",
        "tree-sitter-optimize/recursive-item-inline": "warn",
        "tree-sitter-optimize/recursive-item-extraction": "warn",
        "tree-sitter-optimize/recursive-choice-item-extraction": "warn",
        "tree-sitter-optimize/forwarded-alias-reuse": "warn",
        "tree-sitter-optimize/closing-delimiter-hoist": "warn",
        "tree-sitter-optimize/choice-product-extraction": "warn",
        "tree-sitter-optimize/shared-field-marker": "warn",
        "tree-sitter-optimize/redundant-inherited-field": "warn",
        "tree-sitter-optimize/single-use-field-sequence": "warn",
        "tree-sitter-optimize/shared-valued-fragment": "warn",
        "tree-sitter-optimize/shared-block-close": "warn",
        "tree-sitter-optimize/shared-declaration-tail": "warn",
        "tree-sitter-optimize/short-private-prefix": "warn",
        "tree-sitter-optimize/shared-assignment-clause": "warn",
        "tree-sitter-optimize/shared-delimiter-field-prefix": "warn",
        "tree-sitter-optimize/recursive-continuation-inline": "warn",
        "tree-sitter-optimize/single-use-field-choice": "warn",
        "tree-sitter-optimize/nullable-slot-list": "warn",
        "tree-sitter-optimize/shared-comma-continuation": "warn",
        "tree-sitter-optimize/optional-repetition-inline": "warn",
        "tree-sitter-optimize/shared-comma-field": "warn",
        "tree-sitter-optimize/closing-delimiter-wrapper": "warn",
        "tree-sitter-optimize/single-use-delimited-sequence": "warn",
        "tree-sitter-optimize/ordered-optional-chain": "warn",
        "tree-sitter-optimize/precedence-list-head-extraction": "warn",
        "tree-sitter-optimize/field-list-head-extraction": "warn",
        "tree-sitter-optimize/choice-list-head-extraction": "warn",
        "tree-sitter-optimize/shared-field-chunk": "warn",
        "tree-sitter-optimize/single-use-choice-alias-sequence": "warn",
        "tree-sitter-optimize/single-use-precedence-value": "warn",
        "tree-sitter-optimize/optional-modifier-field": "warn",
        "tree-sitter-optimize/shared-field-body": "warn",
        "tree-sitter-optimize/shared-item-alias": "warn",
        "tree-sitter-optimize/shared-expression-alias": "warn",
        "tree-sitter-optimize/single-use-field-choice-sequence": "warn",
        "tree-sitter-optimize/optional-list-head-extraction": "warn",
        "tree-sitter-optimize/single-use-precedence-clause": "warn",
        "tree-sitter-optimize/field-choice-forwarding-rule": "warn",
        "tree-sitter-optimize/field-forwarding-rule": "warn",
        "tree-sitter-optimize/single-use-alias-sequence": "warn",
        "tree-sitter-optimize/single-use-choice-sequence": "warn",
        "tree-sitter-optimize/single-use-optional-sequence": "warn",
        "tree-sitter-optimize/shared-statement-alias": "warn",
        "tree-sitter-optimize/alias-promotion": "off",
        "tree-sitter-optimize/phrase-alias-extraction": "warn",
        "tree-sitter-optimize/alternative-extraction": "warn",
        "tree-sitter-optimize/body-extraction": "warn",
        "tree-sitter-optimize/broad-dispatcher": "warn",
        "tree-sitter-optimize/chunk-extraction": "warn",
        "tree-sitter-optimize/choice-subset": "warn",
        "tree-sitter-optimize/local-prefix-helper": "warn",
        "tree-sitter-optimize/non-empty-tail-extraction": "warn",
        "tree-sitter-optimize/optional-body-extraction": "warn",
        "tree-sitter-optimize/optional-block-body-extraction": "warn",
        "tree-sitter-optimize/prefix-extraction": "warn",
        "tree-sitter-optimize/single-use-choice": "warn",
        "tree-sitter-optimize/single-use-shared-choice-inline": "warn",
        "tree-sitter-optimize/shared-keyword-inline": "warn",
        "tree-sitter-optimize/single-use-shared-sequence-inline": "warn",
        "tree-sitter-optimize/shared-keyword-alias-choice-inline": "warn",
        "tree-sitter-optimize/recurse": "warn",
        "tree-sitter-optimize/shared-sequence": "warn",
        "tree-sitter-optimize/shared-recursion": "warn",
        "tree-sitter-optimize/shared-repetition": "warn",
        "tree-sitter-optimize/single-use-sequence": "warn",
        "tree-sitter-optimize/single-use-keyword-sequence": "warn",
        "tree-sitter-optimize/single-use-precedence": "warn",
        "tree-sitter-optimize/sequence-subset": "warn",
        "tree-sitter-optimize/recursive-tail-reuse": "warn",
        "tree-sitter-optimize/recursive-body-reuse": "warn",
        "tree-sitter-optimize/list-head-extraction": "warn",
        "tree-sitter-optimize/keyword-reuse": "warn",
        "tree-sitter-optimize/forwarding-rule": "warn",
        "tree-sitter-optimize/shared-choice": "warn",
        "tree-sitter-optimize/tail-extraction": "warn",
        "tree-sitter-optimize/token-packing": "warn"
      }
    }
  ]
}
